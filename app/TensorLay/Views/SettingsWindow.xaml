<Window x:Class="TensorLay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="540" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        WindowStyle="ToolWindow">

    <Border Padding="32,28">
        <DockPanel>

            <!-- Title -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1A1A1A"/>
                <TextBlock Text="SSH tunnel and installation configuration"
                           FontSize="12" Foreground="#9B9B9B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom buttons -->
            <Border DockPanel.Dock="Bottom" Padding="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding ConnectionTestResult}"
                               Foreground="#6B6B6B" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="280"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Test Connection"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,8" Margin="0,0,8,0"
                                Foreground="#6C5CE7" BorderBrush="#6C5CE720"
                                Command="{Binding TestConnectionCommand}"/>
                        <Button Content="Save" Width="90"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0,8" Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Click="OnSaveClicked"/>
                        <Button Content="Cancel" Width="90"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,8"
                                Click="OnCancelClicked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Form fields -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- VPS Host -->
                    <TextBlock Text="VPS HOST" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding VpsHost, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- VPS User -->
                    <TextBlock Text="VPS USER" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding VpsUser, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- SSH Port -->
                    <TextBlock Text="SSH PORT" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- SSH Key -->
                    <TextBlock Text="SSH KEY PATH" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="..." Width="36"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,7" Margin="8,0,0,0"
                                Command="{Binding BrowseSshKeyCommand}"/>
                        <TextBox Text="{Binding SshKeyPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <!-- Install Directory -->
                    <TextBlock Text="INSTALL DIRECTORY" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="..." Width="36"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,7" Margin="8,0,0,0"
                                Command="{Binding BrowseInstallDirCommand}"/>
                        <TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="#EBEBEB" Margin="0,0,0,20"/>

                    <!-- Options -->
                    <TextBlock Text="OPTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AutostartWithWindows}"
                              Content="Start with Windows"
                              Foreground="#1A1A1A" Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding AutoconnectTunnel}"
                              Content="Auto-connect tunnel on startup"
                              Foreground="#1A1A1A"/>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
