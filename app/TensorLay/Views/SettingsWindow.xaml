<Window x:Class="TensorLay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="540" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        WindowStyle="ToolWindow">

    <Border Padding="32,28">
        <DockPanel>

            <!-- Title -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1A1A1A"/>
                <TextBlock Text="SSH tunnel and installation configuration"
                           FontSize="12" Foreground="#9B9B9B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom buttons -->
            <Border DockPanel.Dock="Bottom" Padding="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding ConnectionTestResult}"
                               Foreground="#6B6B6B" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="280"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Test Connection"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,8" Margin="0,0,8,0"
                                Foreground="#6C5CE7" BorderBrush="#6C5CE720"
                                Command="{Binding TestConnectionCommand}"/>
                        <Button Content="Save" Width="90"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0,8" Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Click="OnSaveClicked"/>
                        <Button Content="Cancel" Width="90"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,8"
                                Click="OnCancelClicked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Form fields -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- VPS Host -->
                    <TextBlock Text="VPS HOST" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding VpsHost, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- VPS User -->
                    <TextBlock Text="VPS USER" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding VpsUser, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- SSH Port -->
                    <TextBlock Text="SSH PORT" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- SSH Key -->
                    <TextBlock Text="SSH KEY PATH" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="..." Width="36"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,7" Margin="8,0,0,0"
                                Command="{Binding BrowseSshKeyCommand}"/>
                        <TextBox Text="{Binding SshKeyPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <!-- Pairing (v0.9.26+). The tunnel pins the VPS host-key
                         fingerprints captured at /pair time and refuses anything
                         else, so after the relay moves to a new server (or the
                         server rotates its SSH host keys) every connect ends in
                         HOST KEY MISMATCH. Before 0.9.26 the only way out was
                         editing settings.json by hand. -->
                    <TextBlock Text="PAIRING" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="Re-pair…"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7" Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Foreground="#6C5CE7" BorderBrush="#6C5CE720"
                                Click="OnRepairClicked"/>
                        <TextBlock FontSize="11" Foreground="#9B9B9B" TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            Run the pairing handshake again with a fresh code from the VPS.
                            Use it after the relay moved to a new server or its SSH host
                            keys changed (the tunnel log says HOST KEY MISMATCH).
                        </TextBlock>
                    </DockPanel>

                    <!-- Install Directory -->
                    <TextBlock Text="INSTALL DIRECTORY" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="..." Width="36"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0,7" Margin="8,0,0,0"
                                Command="{Binding BrowseInstallDirCommand}"/>
                        <TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="#EBEBEB" Margin="0,0,0,20"/>

                    <!-- Options -->
                    <TextBlock Text="OPTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AutostartWithWindows}"
                              Content="Start with Windows"
                              Foreground="#1A1A1A" Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding AutoconnectTunnel}"
                              Content="Auto-connect tunnel on startup"
                              Foreground="#1A1A1A"/>

                    <!-- Divider -->
                    <Border Height="1" Background="#EBEBEB" Margin="0,20,0,20"/>

                    <!-- Remote install requests (v0.9.0+) -->
                    <TextBlock Text="REMOTE INSTALL REQUESTS" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9B9B9B" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AllowRemoteInstallRequests}"
                              IsEnabled="{Binding RemoteInstallSupported}"
                              Content="Allow the VPS agent to request model downloads"
                              Foreground="#1A1A1A" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11" Foreground="#9B9B9B" TextWrapping="Wrap"
                               Margin="22,0,0,0">
                        Each request opens an approval dialog before any download starts.
                        Pair against a v0.9.0+ relay to enable this.
                    </TextBlock>

                    <!-- Divider -->
                    <Border Height="1" Background="#EBEBEB" Margin="0,20,0,20"/>

                    <!-- Remote log retrieval (v0.9.12+ desktop / v1.5.0+ relay) -->
                    <TextBlock Text="REMOTE DIAGNOSTIC LOGS" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9B9B9B" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AllowRemoteLogRequests}"
                              IsEnabled="{Binding RemoteInstallSupported}"
                              Content="Allow the VPS agent to fetch local log files"
                              Foreground="#1A1A1A" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11" Foreground="#9B9B9B" TextWrapping="Wrap"
                               Margin="22,0,0,0">
                        When on, agent-initiated requests for diagnostic logs are answered
                        with the recent downloads-YYYY-MM-DD.log files and crash.log
                        (last few days, capped at 5 MB). Useful when an AI agent on the
                        VPS needs to see why a download failed without you copying logs by hand.
                    </TextBlock>

                    <!-- Divider -->
                    <Border Height="1" Background="#EBEBEB" Margin="0,20,0,20"/>

                    <!-- Remote model cleanup (v0.9.27+ desktop / v1.6.0+ relay) -->
                    <TextBlock Text="REMOTE MODEL CLEANUP" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9B9B9B" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AllowRemoteModelCleanup}"
                              IsEnabled="{Binding RemoteInstallSupported}"
                              Content="Allow the VPS agent to see installed models and request deletions"
                              Foreground="#1A1A1A" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11" Foreground="#9B9B9B" TextWrapping="Wrap"
                               Margin="22,0,0,0">
                        When on, the list of model files (names, sizes, folders) and free disk
                        space is shared with the VPS relay so an agent can suggest what to clean up.
                        Every deletion request opens a window where you pick what actually gets deleted.
                    </TextBlock>

                    <!-- Divider -->
                    <Border Height="1" Background="#EBEBEB" Margin="0,20,0,20"/>

                    <!-- Command bridge / "super-bridge" (v0.9.28+) -->
                    <TextBlock Text="COMMAND BRIDGE" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9B9B9B" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding AllowRemoteCommandBridge}"
                              IsEnabled="{Binding RemoteInstallSupported}"
                              Content="Let the VPS agent run commands on this PC"
                              Foreground="#1A1A1A" Margin="0,0,0,6"/>
                    <Border Background="#FEF6F0" BorderBrush="#F3D9C4" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="22,4,0,0">
                        <TextBlock FontSize="11" Foreground="#9A5B2E" TextWrapping="Wrap">
                            This is the most powerful switch here. When on, an agent on your
                            VPS can run shell commands, move files, and start or stop services
                            on THIS computer — the same way the thechest Unity bridge works,
                            but over TensorLay's own tunnel instead of a hand-run ssh&#160;-R.
                            It only works while this app is open and this box is checked, and
                            every request must carry the token below. Leave it off unless you
                            are actively using an agent that needs it.
                        </TextBlock>
                    </Border>

                    <TextBlock Text="BRIDGE TOKEN" FontSize="10" FontWeight="SemiBold" Foreground="#9B9B9B"
                               Margin="22,16,0,6"/>
                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding RemoteCommandBridgeToken, Mode=OneWay}"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 VerticalContentAlignment="Center" Padding="8,6"
                                 Background="#FAFAF7" BorderBrush="#EBEBEB"/>
                        <Button Grid.Column="1" Content="Copy" Width="64" Margin="8,0,0,0"
                                Command="{Binding CopyBridgeTokenCommand}"/>
                        <Button Grid.Column="2" Content="Regenerate" Width="92" Margin="8,0,0,0"
                                Command="{Binding RegenerateBridgeTokenCommand}"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="#9B9B9B" TextWrapping="Wrap" Margin="22,8,0,0">
                        Copy this token to the VPS as
                        <Run FontFamily="Consolas" Text="~/.tensorlay_bridge_token"/>
                        (chmod 600). The agent's client reads it from there. Regenerating
                        rotates the secret — the old token stops working after you Save, so
                        update the VPS file too. The bridge listens on
                        <Run FontFamily="Consolas" Text="127.0.0.1:"/><Run FontFamily="Consolas" Text="{Binding RemoteCommandBridgePort, Mode=OneWay}"/>
                        and is forwarded over the tunnel while connected.
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
