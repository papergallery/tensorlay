<Window x:Class="TensorLay.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TensorLay Update"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="White" BorderBrush="#EBEBEB" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- Portal icon -->
                    <Grid Width="26" Height="26" Margin="0,0,10,0">
                        <Ellipse Width="16" Height="16" StrokeThickness="2.2"
                                 Stroke="#6C5CE7" HorizontalAlignment="Left"/>
                        <Ellipse Width="16" Height="16" StrokeThickness="2.2"
                                 Stroke="#2ECC71" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Tensor" Foreground="#6C5CE7"/><Run Text="Lay" Foreground="#2ECC71"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Name="TitleText" Text="Update available"
                           FontSize="18" FontWeight="Bold" Foreground="#1A1A1A"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#9B9B9B"/>
            </StackPanel>

            <!-- Progress area (hidden initially) -->
            <StackPanel Grid.Row="1" x:Name="ProgressPanel" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <ProgressBar x:Name="DownloadBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                    <TextBlock x:Name="ProgressStatus" Text="Downloading..."
                               FontSize="12" Foreground="#6B6B6B"/>
                    <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right"
                               FontSize="12" Foreground="#9B9B9B" FontFamily="Consolas"/>
                </DockPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SkipButton" Padding="16,8"
                        FontSize="13" Click="OnSkipClicked"
                        Style="{StaticResource SecondaryButton}">
                    <TextBlock Text="Skip" Foreground="#6B6B6B"/>
                </Button>
                <Button x:Name="UpdateButton" Padding="20,8" Margin="10,0,0,0"
                        FontSize="13" FontWeight="SemiBold" Click="OnUpdateClicked"
                        Style="{StaticResource PrimaryButton}">
                    <TextBlock x:Name="UpdateButtonText" Text="Update now" Foreground="White" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
