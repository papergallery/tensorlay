<Window x:Class="TensorLay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TensorLay.Views"
        xmlns:converters="clr-namespace:TensorLay.Converters"
        Title="TensorLay" Width="1340" Height="800"
        MinWidth="900" MinHeight="600"
        Background="White"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisibilityConverter      x:Key="BoolToVisibility"/>
        <converters:StateToColorConverter           x:Key="StateToColor"/>
        <converters:StateToVisibilityConverter      x:Key="StateToVisibility"/>
        <converters:NullToVisibilityConverter       x:Key="NullToVisibility"/>
        <converters:StringEqualityToVisibilityConverter x:Key="PageVis"/>

        <!-- Dashboard service row -->
        <DataTemplate x:Key="DashboardServiceRow">
            <Border Padding="16,12" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status dot -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource StateToColor}}"/>

                    <!-- Name + port -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Text="{Binding Definition.DisplayName}"/>
                        <TextBlock FontSize="11" Foreground="#9B9B9B" Margin="0,2,0,0">
                            <Run Text="{Binding Definition.Category, Mode=OneWay}"/>
                            <Run Text=" · port "/>
                            <Run Text="{Binding Definition.Port, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Status badge -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F7F6F3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Background" Value="#E8F8F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9B9B9B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Starting">
                                            <Setter Property="Foreground" Value="#6C5CE7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}"
                                Padding="14,5" FontSize="12"
                                Command="{Binding StartCommand}"
                                Visibility="{Binding State, Converter={StaticResource StateToVisibility},
                                             ConverterParameter=Stopped}">
                            <TextBlock Text="Start" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource DangerButton}"
                                Padding="14,5" FontSize="12"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding State, Converter={StaticResource StateToVisibility},
                                             ConverterParameter='Running,Starting'}">
                            <TextBlock Text="Stop" Foreground="#E74C3C"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="14,5" FontSize="12"
                                Command="{Binding InstallCommand}"
                                Visibility="{Binding State, Converter={StaticResource StateToVisibility},
                                             ConverterParameter=NotInstalled}">
                            <TextBlock Text="Install" Foreground="#6B6B6B"/>
                        </Button>
                        <Button Style="{StaticResource DangerButton}"
                                Padding="10,5" FontSize="12" Margin="6,0,0,0"
                                Command="{Binding UninstallCommand}"
                                Visibility="{Binding State, Converter={StaticResource StateToVisibility},
                                             ConverterParameter=Stopped}">
                            <TextBlock Text="Uninstall" Foreground="#E74C3C"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== TITLE BAR (spans full width) ==================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White"
                BorderBrush="#F0EDE8" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Logo (left) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="16,0,0,0">
                    <!-- Portal icon -->
                    <Grid Width="26" Height="26" Margin="0,0,8,0">
                        <Ellipse Width="16" Height="16" StrokeThickness="2.2"
                                 Stroke="#6C5CE7" HorizontalAlignment="Left"/>
                        <Ellipse Width="16" Height="16" StrokeThickness="2.2"
                                 Stroke="#2ECC71" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Tensor" Foreground="#6C5CE7"/><Run Text="Lay" Foreground="#2ECC71"/>
                    </TextBlock>
                    <Border Background="#F3F0EB" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#9B9B9B" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Window buttons (right) — Win11 style, all 10x10 viewbox -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize: horizontal line -->
                    <Button x:Name="MinimizeBtn" Click="OnMinimizeClick"
                            Width="46" BorderThickness="0" Cursor="Hand"
                            Background="Transparent" VerticalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <Path x:Name="MinIcon"
                                          Data="M0,5 L10,5"
                                          Stroke="#6B6B6B" StrokeThickness="1"
                                          Width="10" Height="10" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0A000000"/>
                                        <Setter TargetName="MinIcon" Property="Stroke" Value="#1A1A1A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Maximize: square -->
                    <Button x:Name="MaximizeBtn" Click="OnMaximizeClick"
                            Width="46" BorderThickness="0" Cursor="Hand"
                            Background="Transparent" VerticalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <Path x:Name="MaxIcon"
                                          Data="M0,0 L10,0 L10,10 L0,10 Z"
                                          Stroke="#6B6B6B" StrokeThickness="1" Fill="Transparent"
                                          Width="10" Height="10" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0A000000"/>
                                        <Setter TargetName="MaxIcon" Property="Stroke" Value="#1A1A1A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Close: X -->
                    <Button x:Name="CloseBtn" Click="OnCloseClick"
                            Width="46" BorderThickness="0" Cursor="Hand"
                            Background="Transparent" VerticalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <Path x:Name="CloseIcon"
                                          Data="M0,0 L10,10 M10,0 L0,10"
                                          Stroke="#6B6B6B" StrokeThickness="1"
                                          Width="10" Height="10" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                        <Setter TargetName="CloseIcon" Property="Stroke" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C50F1F"/>
                                        <Setter TargetName="CloseIcon" Property="Stroke" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#F0EDE8" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Bottom: tunnel + settings -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">

                    <!-- Tunnel status card -->
                    <Border Background="#F7F6F3" CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                            BorderBrush="#F0F0F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SSH TUNNEL" FontSize="9" FontWeight="Bold"
                                           Foreground="#9B9B9B" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#C5C5C5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTunnelConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#2ECC71"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding TunnelStatus}" FontSize="12" FontWeight="Medium"
                                               Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Connect" Padding="8,4" FontSize="11"
                                        Command="{Binding ConnectTunnelCommand}"
                                        Visibility="{Binding IsTunnelConnected,
                                            Converter={StaticResource BoolToVisibility},
                                            ConverterParameter=Invert}"/>
                                <Button Style="{StaticResource DangerButton}"
                                        Content="Disc." Padding="8,4" FontSize="11"
                                        Command="{Binding DisconnectTunnelCommand}"
                                        Visibility="{Binding IsTunnelConnected,
                                            Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Settings link -->
                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" FontSize="14" Margin="0,0,10,0" Foreground="#9B9B9B"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" Foreground="#9B9B9B"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">

                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Dashboard">
                                        <Setter Property="Background" Value="#F3F0EB"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2302;" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Services">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Services">
                                        <Setter Property="Background" Value="#F3F0EB"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x25A6;" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Services" VerticalAlignment="Center"/>
                            <Border Background="#E8F8F0" CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveServicesCount}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#2ECC71"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Models">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Models">
                                        <Setter Property="Background" Value="#F3F0EB"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x25B3;" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Models" VerticalAlignment="Center"/>
                            <!-- Pending remote-install requests badge (v0.9.0). Purple
                                 fill matches the brand accent; visible only while there
                                 are unhandled requests so it doesn't take screen space
                                 in the steady state. -->
                            <Border Background="#6C5CE7" CornerRadius="8" Padding="6,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasPendingRemoteTasks,
                                                 Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PendingRemoteTaskCount}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}" CommandParameter="Logs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="Logs">
                                        <Setter Property="Background" Value="#F3F0EB"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2261;" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== CONTENT AREA ==================== -->
        <Grid Grid.Row="1" Grid.Column="1" Background="#FAFAF7">

            <!-- ========== DASHBOARD ========== -->
            <ScrollViewer Background="#FAFAF7"
                          Padding="36,28,36,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding SelectedPage,
                              Converter={StaticResource PageVis},
                              ConverterParameter=Dashboard}">
                <StackPanel>
                    <!-- Greeting -->
                    <TextBlock FontSize="16" Foreground="#6B6B6B" Margin="0,0,0,24">
                        <Run Text="Welcome back, "/>
                        <Run Text="User" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </TextBlock>

                    <!-- Stats row (full width) -->
                    <Border Background="White" CornerRadius="16" Margin="0,0,0,28"
                            BorderBrush="#EBEBEB" BorderThickness="1" Padding="24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- GPU name -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuInfo.GpuName, FallbackValue='No GPU'}"
                                           FontSize="17" FontWeight="Bold" Foreground="#1A1A1A"/>
                                <TextBlock Text="GPU detected" FontSize="11" Foreground="#6B6B6B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#F0F0F0" Margin="16,0"/>

                            <!-- VRAM -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="Bold" Foreground="#1A1A1A"
                                           Text="{Binding VramDisplay, FallbackValue='-- / -- GB'}"/>
                                <TextBlock Text="VRAM usage" FontSize="11" Foreground="#6B6B6B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Background="#F0F0F0" Margin="16,0"/>

                            <!-- Temperature -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="Bold" Foreground="#1A1A1A">
                                    <Run Text="{Binding GpuInfo.TemperatureCelsius, StringFormat='{}{0:F0}', FallbackValue='--', Mode=OneWay}"/><Run Text=" C" FontSize="11" Foreground="#9B9B9B" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock Text="temperature" FontSize="11" Foreground="#6B6B6B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="5" Width="1" Background="#F0F0F0" Margin="16,0"/>

                            <!-- Active services -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="Bold" Foreground="#1A1A1A">
                                    <Run Text="{Binding ActiveServicesCount, FallbackValue='0', Mode=OneWay}"/><Run Text=" / 6" FontSize="11" Foreground="#9B9B9B" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock Text="active services" FontSize="11" Foreground="#6B6B6B" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Services header -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <!-- Title switches based on HasInstalledServices -->
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Available Services"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInstalledServices}" Value="True">
                                            <Setter Property="Text" Value="Installed Services"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding HasInstalledServices,
                                        Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" FontSize="12" Margin="0,0,8,0"
                                    Command="{Binding StopAllCommand}">
                                <TextBlock Text="Stop All" Foreground="#6B6B6B"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Padding="14,6" FontSize="12"
                                    Command="{Binding StartAllCommand}">
                                <TextBlock Text="Start All" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Services list (filtered in code-behind) -->
                    <Border Background="White" CornerRadius="12"
                            BorderBrush="#EBEBEB" BorderThickness="1" Padding="0">
                        <ItemsControl x:Name="HomeServicesPanel"
                                      ItemTemplate="{StaticResource DashboardServiceRow}"/>
                    </Border>

                    <!-- Models header -->
                    <DockPanel LastChildFill="False" Margin="0,28,0,12">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Available Models"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasModels}" Value="True">
                                            <Setter Property="Text" Value="Installed Models"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <Border Background="White" CornerRadius="12"
                            BorderBrush="#EBEBEB" BorderThickness="1" Padding="0">
                        <ItemsControl x:Name="HomeModelsPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,11" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F7F6F3" CornerRadius="4"
                                                    Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding ServiceName}"
                                                           Foreground="#6B6B6B" FontSize="11" FontWeight="Medium"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                       Foreground="#1A1A1A" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                       Foreground="#9B9B9B" FontSize="11" FontFamily="Consolas"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <Button Grid.Column="3" Style="{StaticResource DangerButton}"
                                                    Padding="8,3" FontSize="11" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Delete" Foreground="#E74C3C"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== SERVICES ========== -->
            <ScrollViewer Background="#FAFAF7"
                          Padding="36,28,36,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding SelectedPage,
                              Converter={StaticResource PageVis},
                              ConverterParameter=Services}">
                <StackPanel>
                    <TextBlock Text="AI Services" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1A1A1A" Margin="0,0,0,24"/>
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:ServiceCard DataContext="{Binding}" Margin="0,0,0,14"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== MODELS ========== -->
            <DockPanel Background="#FAFAF7"
                       Visibility="{Binding SelectedPage,
                           Converter={StaticResource PageVis},
                           ConverterParameter=Models}">

                <StackPanel DockPanel.Dock="Top" Margin="36,28,36,16">
                    <TextBlock Text="Installed Models" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                </StackPanel>

                <!-- Column headers -->
                <Border DockPanel.Dock="Top" Margin="36,0,36,4" Padding="16,8"
                        BorderBrush="#EBEBEB" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SERVICE" FontSize="10"
                                   Foreground="#9B9B9B" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="MODEL" FontSize="10"
                                   Foreground="#9B9B9B" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="SIZE" FontSize="10"
                                   Foreground="#9B9B9B" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="3" Text="" FontSize="10"
                                   Foreground="#9B9B9B" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <ScrollViewer DockPanel.Dock="Top" Margin="36,0,36,24"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AllModelsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        Margin="0,0,0,0" Padding="16,12"
                                        BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F7F6F3" CornerRadius="4"
                                                Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ServiceName}"
                                                       Foreground="#6B6B6B" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                   Foreground="#1A1A1A" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                   Foreground="#9B9B9B" FontSize="12"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                        <Button Grid.Column="3" Content="Delete"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,3" FontSize="11"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ========== LOGS ========== -->
            <DockPanel Background="#FAFAF7"
                       Visibility="{Binding SelectedPage,
                           Converter={StaticResource PageVis},
                           ConverterParameter=Logs}">

                <Border DockPanel.Dock="Top" Background="White"
                        BorderBrush="#EBEBEB" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False" Margin="36,14,36,14">
                        <TextBlock Text="System Logs" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ClearLogsButton" Content="Clear"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" FontSize="12" Margin="0,0,8,0"/>
                            <Button x:Name="CopyLogsButton" Content="Copy"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Log viewer (light, matching app style) -->
                <Border Margin="36,16,36,24" CornerRadius="12"
                        Background="White" BorderBrush="#EBEBEB" BorderThickness="1">
                    <ListBox ItemsSource="{Binding LogLines}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas" FontSize="12"
                             Foreground="#4A4A4A"
                             Padding="20,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             x:Name="LogListBox">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"         Value="0,2"/>
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="Foreground"      Value="#4A4A4A"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5F3EE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>

        </Grid>
    </Grid>
</Window>
