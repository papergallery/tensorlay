<Window x:Class="TensorLay.Views.UninstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall service"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadlineText"
                   FontSize="18" FontWeight="SemiBold"
                   Text="Uninstall {service}?"/>

        <TextBlock Grid.Row="1" Margin="0,12,0,0"
                   TextWrapping="Wrap" FontSize="13" Foreground="#4A4A4A"
                   x:Name="BodyText"
                   Text="This will remove the service installation directory and ~{X} GB of files."/>

        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                   TextWrapping="Wrap" FontSize="12" Foreground="#9A8E78"
                   x:Name="PathText"
                   Text=""/>

        <CheckBox Grid.Row="3" x:Name="KeepModelsCheckbox"
                  Margin="0,16,0,0"
                  IsChecked="True"
                  FontSize="13"
                  Content="Keep downloaded models (preserves the models folder)"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Padding="18,7" Margin="0,0,8,0"
                    IsCancel="True"
                    MinWidth="92"
                    Click="OnCancelClick"/>
            <Button x:Name="UninstallButton"
                    Content="Uninstall"
                    Padding="18,7"
                    MinWidth="92"
                    Background="#E74C3C" Foreground="White"
                    BorderBrush="#C0392B"
                    Click="OnUninstallClick"/>
        </StackPanel>
    </Grid>
</Window>
