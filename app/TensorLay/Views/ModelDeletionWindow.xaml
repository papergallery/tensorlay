<Window x:Class="TensorLay.Views.ModelDeletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TensorLay.Converters"
        Title="{Binding WindowTitle}" Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#F0EDE8" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="16,0,0,0">
                    <Grid Width="22" Height="22" Margin="0,0,8,0">
                        <Ellipse Width="13" Height="13" StrokeThickness="1.8"
                                 Stroke="#6C5CE7" HorizontalAlignment="Left"/>
                        <Ellipse Width="13" Height="13" StrokeThickness="1.8"
                                 Stroke="#2ECC71" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Tensor" Foreground="#6C5CE7"/><Run Text="Lay" Foreground="#2ECC71"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#9B9B9B" VerticalAlignment="Center">
                        <Run Text="  —  "/><Run Text="{Binding WindowTitle, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Button Click="OnCloseClicked" Width="46" HorizontalAlignment="Right"
                        VerticalAlignment="Stretch" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="11" Foreground="#6B6B6B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F3E5E1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="36,20,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Source (remote only) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14"
                        Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="REQUEST FROM" FontSize="10" FontWeight="SemiBold"
                           Foreground="#9B9B9B"/>
                <TextBlock Text="{Binding AgentLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1A1A1A" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Reason (remote, optional) -->
            <Border Grid.Row="1" Background="#F7F6F3" CornerRadius="6" Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="REASON" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9B9B9B" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Reason, Mode=OneWay}" FontSize="12" Foreground="#1A1A1A"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- List header -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="FILES TO DELETE" FontSize="10" FontWeight="SemiBold"
                           Foreground="#9B9B9B" VerticalAlignment="Bottom"/>
                <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Bottom"
                           Visibility="{Binding ShowDecisionButtons, Converter={StaticResource BoolToVisibility}}">
                    <Hyperlink Command="{Binding SelectAllCommand}" CommandParameter="all"
                               Foreground="#6B6B6B">Select all</Hyperlink>
                    <Run Text="  ·  " Foreground="#C0C0C0"/>
                    <Hyperlink Command="{Binding SelectAllCommand}" CommandParameter="none"
                               Foreground="#6B6B6B">None</Hyperlink>
                </TextBlock>
            </DockPanel>

            <!-- File list -->
            <Border Grid.Row="3" BorderBrush="#EBEBEB" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock Text="Checking files…" FontSize="12" Foreground="#9B9B9B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,10,0"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanDelete, Mode=OneWay}"/>
                                            <StackPanel Grid.Column="1" ToolTip="{Binding Location, Mode=OneWay}">
                                                <TextBlock Text="{Binding FileName, Mode=OneWay}" FontSize="13"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#9B9B9B" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ServiceName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Folder, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Problem, Mode=OneWay}" FontSize="11"
                                                           Foreground="#E67E22" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding ResultText}" FontSize="11" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#27AE60"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay, Mode=OneWay}"
                                                       FontFamily="Consolas" FontSize="12" Foreground="#6B6B6B"
                                                       VerticalAlignment="Top" Margin="12,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Summary + status -->
            <StackPanel Grid.Row="4" Margin="0,12,0,14">
                <TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold"
                           Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock FontSize="11" Foreground="#9B9B9B" Margin="0,3,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ShowDecisionButtons, Converter={StaticResource BoolToVisibility}}"
                           Text="Files are deleted permanently. They do not go to the Recycle Bin."/>
            </StackPanel>

            <!-- Buttons -->
            <DockPanel Grid.Row="5" LastChildFill="False">
                <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="#9B9B9B"
                           Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Expires "/>
                    <Run Text="{Binding ExpiresDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <!-- Right-aligned, declared right-most first (DockPanel) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                        Padding="18,8" FontSize="13" Margin="8,0,0,0"
                        Content="{Binding DeleteButtonText}"
                        Command="{Binding DeleteSelectedCommand}"
                        Visibility="{Binding ShowDecisionButtons, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Padding="18,8" FontSize="13" Margin="8,0,0,0"
                        Content="{Binding DismissButtonText}"
                        Command="{Binding DismissCommand}"
                        Visibility="{Binding ShowDecisionButtons, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" FontSize="13" Margin="8,0,0,0"
                        Content="Close"
                        Command="{Binding DismissCommand}"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
