<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Used by SettingsViewModel.BrowseInstallDir for FolderBrowserDialog —
         WPF .NET 8 still has no native folder picker. Was previously pulled
         in transitively by a now-removed package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>GpuHub</AssemblyName>
    <RootNamespace>TensorLay</RootNamespace>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <Version>0.9.30</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!-- Models, services, registry and view models live in TensorLay.Core,
       shared with the macOS front end (TensorLay.Mac). Its packages
       (CommunityToolkit.Mvvm, SSH.NET, ProtectedData) flow in from there. -->
  <ItemGroup>
    <ProjectReference Include="..\TensorLay.Core\TensorLay.Core.csproj" />
  </ItemGroup>

  <!-- UseWindowsForms above pulls System.Windows.Forms AND System.Drawing
       into ImplicitUsings, which collides with WPF (Application, Timer,
       UserControl, Color, ...). The only thing we actually want from
       WinForms is FolderBrowserDialog, referenced via a
       `WinForms = System.Windows.Forms` alias in SettingsViewModel —
       so strip the global usings and keep the explicit alias. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\app.ico" />
    <Resource Include="Resources\Icons\app_icon.png" />
  </ItemGroup>

</Project>
