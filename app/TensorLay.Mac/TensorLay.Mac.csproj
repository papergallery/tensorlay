<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS front end (Avalonia). Business logic and view models come from
       TensorLay.Core, shared with the WPF app; this project holds only the
       windows, the IUiHost implementation and app startup. Packaged into
       TensorLay.app by ../publish-mac.sh (osx-arm64, ad-hoc signed). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TensorLay.Mac</RootNamespace>
    <AssemblyName>TensorLay</AssemblyName>
    <Version>0.9.31</Version>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TensorLay.Core\TensorLay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
